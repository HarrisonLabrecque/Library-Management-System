{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Library Management System",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-I${workspaceFolder}\\include",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\src\\Book.cpp",
                "${workspaceFolder}\\src\\Student.cpp",
                "${workspaceFolder}\\src\\Library.cpp",
                "${workspaceFolder}\\src\\FileManager.cpp",
                "${workspaceFolder}\\src\\IssueReturn.cpp",
                "-o",
                "${workspaceFolder}\\LibraryManagementSystem.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}